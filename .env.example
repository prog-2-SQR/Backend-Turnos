# Copiar a .env y completar con valores reales. El archivo .env no se commitea.
# Lo leen docker compose (para crear la base) y la aplicación (para conectarse).

# Base de datos propia del servicio de turnos
DB_HOST=localhost
DB_PORT=5433
DB_NAME=turnos
DB_USERNAME=turnos
DB_PASSWORD=cambiar-esta-password

# Secreto para firmar los JWT de los usuarios de la app (no es el JWT de la cátedra).
# Generar uno propio con: openssl rand -base64 64 | tr -d '\n'
JWT_BASE64_SECRET=cambiar-por-un-secreto-propio-de-64-bytes-en-base64
